    {
      "name": "LINE",
      "item": [
        {
          "name": "POST /api/line/webhook",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// เซ็น raw body ด้วย channel secret (HMAC-SHA256 แบบ base64) เหมือน LINE",
                  "const secret = pm.variables.get('lineChannelSecret');",
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
                  "const signature = CryptoJS.HmacSHA256(body, secret || '').toString(CryptoJS.enc.Base64);",
                  "pm.variables.set('lineSignature', signature);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}",
                "type": "text",
                "description": "ไม่บังคับ ใช้ค้น log ระบบส่งค่ากลับใน response header X-Request-Id และใน error body (request_id)"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-line-signature",
                "value": "{{lineSignature}}",
                "type": "text",
                "description": "สร้างอัตโนมัติจาก pre-request script"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"U0123456789abcdef0123456789abcdef\",\n  \"events\": [\n    {\n      \"type\": \"message\",\n      \"mode\": \"active\",\n      \"timestamp\": 1763270000000,\n      \"webhookEventId\": \"01POSTMANTESTEVENT000000000\",\n      \"deliveryContext\": {\n        \"isRedelivery\": false\n      },\n      \"replyToken\": \"00000000000000000000000000000000\",\n      \"source\": {\n        \"type\": \"user\",\n        \"userId\": \"U00000000000000000000000000000000\"\n      },\n      \"message\": {\n        \"id\": \"1\",\n        \"type\": \"text\",\n        \"text\": \"test from postman\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/line/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "line",
                "webhook"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "LINE signature. จำลอง LINE ส่ง webhook มาที่ center-hook ตั้ง lineChannelSecret ให้ตรงกับ LINE_CHANNEL_SECRET ของ server ก่อน pre-request script จะเซ็น body ให้\nตอบ 200 { message, received } ทันที แล้วส่งต่อไป project ปลายทางเบื้องหลัง ดูผลที่ Forward Logs\n401 INVALID_LINE_SIGNATURE, 503 LINE_WEBHOOK_NOT_CONFIGURED\nข้อควรระวัง: event นี้ถูกส่งต่อไปปลายทางจริงตาม LABOR_WEBHOOK_URL / WEBHOOK_URL"
          },
          "response": []
        }
      ]
    },
