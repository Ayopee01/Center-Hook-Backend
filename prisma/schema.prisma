generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(512)
  // owner | admin
  role         String   @db.VarChar(20)
  status       String   @default("active") @db.VarChar(20)
  fullName     String   @map("full_name") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(3)

  sessions UserSession[]

  @@map("accounts")
}

model UserSession {
  id               Int       @id @default(autoincrement())
  accountId        Int       @map("account_id")
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  isActive         Boolean   @default(true) @map("is_active")
  expiresAt        DateTime  @map("expires_at") @db.Timestamp(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamp(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([accountId, isActive])
  @@map("user_sessions")
}

model ForwardLog {
  id             Int       @id @default(autoincrement())
  // id ของ request ที่ LINE ส่งมา (event ใน request เดียวกันใช้ค่าเดียวกัน)
  requestId      String    @map("request_id") @db.VarChar(64)
  webhookEventId String?   @map("webhook_event_id") @db.VarChar(64)
  // ชื่อ project ปลายทาง เช่น labor | default
  project        String    @db.VarChar(50)
  targetUrl      String?   @map("target_url") @db.VarChar(1024)
  lineUserId     String?   @map("line_user_id") @db.VarChar(64)
  eventType      String    @map("event_type") @db.VarChar(50)
  messageType    String?   @map("message_type") @db.VarChar(50)
  content        String?   @db.Text
  payload        Json
  // SUCCESS | FAILED | SKIPPED
  status         String    @db.VarChar(20)
  httpStatus     Int?      @map("http_status")
  responseBody   String?   @map("response_body") @db.Text
  errorMessage   String?   @map("error_message") @db.Text
  attempts       Int       @default(0)
  durationMs     Int       @default(0) @map("duration_ms")
  forwardedAt    DateTime? @map("forwarded_at") @db.Timestamp(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(3)

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([project, createdAt])
  @@index([lineUserId, createdAt])
  @@map("forward_logs")
}
