# Server
PORT=8080
CORS_ORIGIN=
SHUTDOWN_TIMEOUT_MS=15000

# Rate limiting (/api/auth, /api/accounts, /api/forward-logs, /api-docs)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_LOGIN_RATE_LIMIT_MAX_PER_IP=1000

# Forward behaviour (optional)
FORWARD_TIMEOUT_MS=10000
FORWARD_MAX_ATTEMPTS=3
FORWARD_RETRY_DELAY_MS=1000
FORWARD_LOG_RETENTION_DAYS=90

# Swagger /api-docs Basic auth 
API_DOCS_USERNAME=
API_DOCS_PASSWORD=

# PostgreSQL / Prisma 
